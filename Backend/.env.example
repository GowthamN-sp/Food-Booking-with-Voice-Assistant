# Copy this file to .env for local development. Never commit .env.
# Generate a unique key using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL - use your existing Savora database
DB_NAME=voiceassistant
DB_USER=root
DB_PASSWORD=replace-with-your-local-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# The exact frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=False

# Optional AI voice parsing. Without it Echo provides rule-based fallback commands.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Razorpay TEST credentials first. Keep the secret only on the backend.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Comma-separated admin account emails allowed to update order fulfillment status
SAVORA_ADMIN_EMAILS=

# For HTTPS deployment, set these deliberately for your host:
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
